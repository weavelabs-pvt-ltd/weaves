(public_tls) {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
}

# Every route to the API replaces X-Forwarded-For with the real peer address, so
# the API's rate limiter (uvicorn --proxy-headers) never trusts a client header.
# The API's internal metrics route is for the Docker network only; no public
# host ever reaches it (the API also refuses requests that carry proxy headers).
(api_upstream) {
	@internal path /api/v0/internal/*
	respond @internal 404
	reverse_proxy product-api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}

weave-studio.in, www.weave-studio.in, app.weave-studio.in {
	import public_tls
	encode zstd gzip
	@app_api {
		host app.weave-studio.in
		path /api/v0/*
	}
	# The public waitlist is the only API path the website host serves. It is
	# same-origin (a relative URL on the website), so no CORS or cookie is used.
	@waitlist_api {
		host weave-studio.in www.weave-studio.in
		path /api/v0/waitlist/*
	}
	handle @app_api {
		import api_upstream
	}
	handle @waitlist_api {
		import api_upstream
	}
	handle {
		reverse_proxy frontend:8080
	}
}

api.weave-studio.in {
	import public_tls
	import api_upstream
}
