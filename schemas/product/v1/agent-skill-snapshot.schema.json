{
  "additionalProperties": false,
  "description": "Version-pinned, trusted instructions selected from the skill catalog.",
  "properties": {
    "content_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Digest"
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 50,
      "title": "Files",
      "type": "object"
    },
    "instructions": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "skill_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Skill Id",
      "type": "string"
    },
    "source_skill_version_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Skill Version Id"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "skill_id",
    "version",
    "name",
    "instructions"
  ],
  "title": "AgentSkillSnapshot",
  "type": "object"
}
