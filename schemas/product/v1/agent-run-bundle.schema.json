{
  "$defs": {
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Runtime Seconds",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_run_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Run Cost Usd"
        }
      },
      "title": "AgentBudget",
      "type": "object"
    },
    "AgentRun": {
      "additionalProperties": false,
      "description": "One agent-level execution attempt and its metered model result.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "agent_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Run Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Version Id",
          "type": "string"
        },
        "model_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Profile Id",
          "type": "string"
        },
        "resolved_provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resolved Provider Id",
          "type": "string"
        },
        "resolved_model_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resolved Model Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "input_summary": {
          "additionalProperties": true,
          "title": "Input Summary",
          "type": "object"
        },
        "output_summary": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Summary"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "org_id",
        "workspace_id",
        "agent_run_id",
        "run_id",
        "agent_id",
        "agent_version_id",
        "model_profile_id",
        "resolved_provider_id",
        "resolved_model_id",
        "status"
      ],
      "title": "AgentRun",
      "type": "object"
    },
    "AgentSkillSnapshot": {
      "additionalProperties": false,
      "description": "Version-pinned, trusted instructions selected from the skill catalog.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "instructions": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "version",
        "name",
        "instructions"
      ],
      "title": "AgentSkillSnapshot",
      "type": "object"
    },
    "AgentVersion": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "agent_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Version Id",
          "type": "string"
        },
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "persona": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Persona",
          "type": "string"
        },
        "instructions": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "model_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Profile Id",
          "type": "string"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/AgentSkillSnapshot"
          },
          "maxItems": 50,
          "title": "Skills",
          "type": "array"
        },
        "allowed_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Allowed Capability Ids",
          "type": "array"
        },
        "allowed_workflow_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Allowed Workflow Ids",
          "type": "array"
        },
        "approval_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Policy Id"
        },
        "budget_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Policy Id"
        },
        "memory_policy": {
          "$ref": "#/$defs/MemoryPolicy"
        },
        "budget": {
          "$ref": "#/$defs/AgentBudget"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        }
      },
      "required": [
        "created_at",
        "org_id",
        "workspace_id",
        "agent_version_id",
        "agent_id",
        "version",
        "persona",
        "instructions",
        "model_profile_id"
      ],
      "title": "AgentVersion",
      "type": "object"
    },
    "ErrorSummary": {
      "additionalProperties": false,
      "description": "Bounded user-safe error details; stack traces and provider payloads do not belong here.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "ErrorSummary",
      "type": "object"
    },
    "JsonValue": {},
    "MemoryPolicy": {
      "additionalProperties": false,
      "description": "Scopes an agent may retrieve during a run; defaults to workspace memory.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "allowed_scopes": {
          "default": [
            "workspace"
          ],
          "items": {
            "$ref": "#/$defs/MemoryScope"
          },
          "title": "Allowed Scopes",
          "type": "array"
        },
        "max_items": {
          "default": 8,
          "maximum": 50,
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        }
      },
      "title": "MemoryPolicy",
      "type": "object"
    },
    "MemoryScope": {
      "enum": [
        "none",
        "thread",
        "workflow",
        "workspace",
        "organization"
      ],
      "title": "MemoryScope",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An agent run pinned to the exact published agent version.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run": {
      "$ref": "#/$defs/AgentRun"
    },
    "agent_version": {
      "$ref": "#/$defs/AgentVersion"
    }
  },
  "required": [
    "run",
    "agent_version"
  ],
  "title": "AgentRunBundle",
  "type": "object"
}
