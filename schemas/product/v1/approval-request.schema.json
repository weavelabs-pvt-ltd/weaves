{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "cancelled"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Human decision record for a proposed write capability.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "approval_request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approval Request Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "requested_by_agent_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested By Agent Run Id"
    },
    "requested_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Requested By Principal Id",
      "type": "string"
    },
    "capability_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Capability Id",
      "type": "string"
    },
    "action_summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Action Summary",
      "type": "string"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "resolved_by_principal_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved By Principal Id"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "decision_comment": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Comment"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "approval_request_id",
    "run_id",
    "requested_by_principal_id",
    "capability_id",
    "action_summary",
    "risk_level",
    "status",
    "requested_at"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
