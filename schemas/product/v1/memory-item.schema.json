{
  "$defs": {
    "MemoryRetentionClass": {
      "enum": [
        "ephemeral",
        "standard",
        "regulated",
        "locked"
      ],
      "title": "MemoryRetentionClass",
      "type": "string"
    },
    "MemoryScope": {
      "enum": [
        "none",
        "thread",
        "workflow",
        "workspace",
        "organization"
      ],
      "title": "MemoryScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "memory_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Memory Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/MemoryScope"
    },
    "workspace_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    },
    "scope_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Ref"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ref"
    },
    "retention_class": {
      "$ref": "#/$defs/MemoryRetentionClass",
      "default": "standard"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "memory_id",
    "scope",
    "title",
    "text"
  ],
  "title": "MemoryItem",
  "type": "object"
}
