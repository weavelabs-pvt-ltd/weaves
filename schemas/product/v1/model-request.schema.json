{
  "$defs": {
    "ModelMessage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/ModelMessageRole"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ModelMessage",
      "type": "object"
    },
    "ModelMessageRole": {
      "enum": [
        "system",
        "user",
        "assistant"
      ],
      "title": "ModelMessageRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ModelMessage"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "temperature": {
      "default": 0.2,
      "maximum": 2.0,
      "minimum": 0.0,
      "title": "Temperature",
      "type": "number"
    },
    "max_output_tokens": {
      "default": 2048,
      "maximum": 32768,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    }
  },
  "required": [
    "messages"
  ],
  "title": "ModelRequest",
  "type": "object"
}
