{
  "$defs": {
    "CapabilityKind": {
      "enum": [
        "context.read",
        "action.write",
        "delivery.send"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "CapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Capability Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "risk_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "approval_supported": {
          "default": false,
          "title": "Approval Supported",
          "type": "boolean"
        }
      },
      "required": [
        "capability_id",
        "name",
        "kind",
        "input_schema",
        "output_schema"
      ],
      "title": "CapabilitySpec",
      "type": "object"
    },
    "JsonValue": {},
    "PluginDescriptor": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "plugin_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_type": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Plugin Type",
          "type": "string"
        },
        "display_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "capability_manifest": {
          "items": {
            "$ref": "#/$defs/CapabilitySpec"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Capability Manifest",
          "type": "array"
        },
        "auth_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth Schema"
        },
        "configuration_schema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Schema"
        },
        "status": {
          "$ref": "#/$defs/PluginDescriptorStatus"
        }
      },
      "required": [
        "plugin_id",
        "plugin_type",
        "display_name",
        "capability_manifest",
        "status"
      ],
      "title": "PluginDescriptor",
      "type": "object"
    },
    "PluginDescriptorStatus": {
      "enum": [
        "active",
        "deprecated",
        "disabled"
      ],
      "title": "PluginDescriptorStatus",
      "type": "string"
    },
    "PluginInstallation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "plugin_installation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plugin Installation Id",
          "type": "string"
        },
        "plugin_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plugin Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "auth_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth Ref"
        },
        "configuration": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Configuration",
          "type": "object"
        },
        "enabled_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Enabled Capability Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/PluginInstallationStatus"
        },
        "last_healthcheck_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Healthcheck At"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "org_id",
        "workspace_id",
        "plugin_installation_id",
        "plugin_id",
        "display_name",
        "status"
      ],
      "title": "PluginInstallation",
      "type": "object"
    },
    "PluginInstallationStatus": {
      "enum": [
        "active",
        "disabled",
        "error"
      ],
      "title": "PluginInstallationStatus",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "descriptor": {
      "$ref": "#/$defs/PluginDescriptor"
    },
    "installation": {
      "$ref": "#/$defs/PluginInstallation"
    }
  },
  "required": [
    "descriptor",
    "installation"
  ],
  "title": "PluginInstallationBinding",
  "type": "object"
}
