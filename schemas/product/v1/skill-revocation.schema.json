{
  "additionalProperties": false,
  "description": "Immutable record that blocks one published release at runtime.",
  "properties": {
    "content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "revocation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Revocation Id",
      "type": "string"
    },
    "revoked_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Revoked By Principal Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "skill_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Skill Id",
      "type": "string"
    },
    "skill_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Skill Version Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "org_id",
    "revocation_id",
    "skill_id",
    "skill_version_id",
    "content_digest",
    "revoked_by_principal_id",
    "reason"
  ],
  "title": "SkillRevocation",
  "type": "object"
}
