{
  "$defs": {
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "max_runtime_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Runtime Seconds",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_run_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Run Cost Usd"
        }
      },
      "title": "AgentBudget",
      "type": "object"
    },
    "AgentSkillSnapshot": {
      "additionalProperties": false,
      "description": "Version-pinned, trusted instructions selected from the skill catalog.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "instructions": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "version",
        "name",
        "instructions"
      ],
      "title": "AgentSkillSnapshot",
      "type": "object"
    },
    "JsonValue": {},
    "MemoryPolicy": {
      "additionalProperties": false,
      "description": "Scopes an agent may retrieve during a run; defaults to workspace memory.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "allowed_scopes": {
          "default": [
            "workspace"
          ],
          "items": {
            "$ref": "#/$defs/MemoryScope"
          },
          "title": "Allowed Scopes",
          "type": "array"
        },
        "max_items": {
          "default": 8,
          "maximum": 50,
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        }
      },
      "title": "MemoryPolicy",
      "type": "object"
    },
    "MemoryScope": {
      "enum": [
        "none",
        "thread",
        "workflow",
        "workspace",
        "organization"
      ],
      "title": "MemoryScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "agent_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Version Id",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "persona": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Persona",
      "type": "string"
    },
    "instructions": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "model_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Model Profile Id",
      "type": "string"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/AgentSkillSnapshot"
      },
      "maxItems": 50,
      "title": "Skills",
      "type": "array"
    },
    "allowed_capability_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Allowed Capability Ids",
      "type": "array"
    },
    "allowed_workflow_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Allowed Workflow Ids",
      "type": "array"
    },
    "approval_policy_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Policy Id"
    },
    "budget_policy_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Policy Id"
    },
    "memory_policy": {
      "$ref": "#/$defs/MemoryPolicy"
    },
    "budget": {
      "$ref": "#/$defs/AgentBudget"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Schema"
    }
  },
  "required": [
    "created_at",
    "org_id",
    "workspace_id",
    "agent_version_id",
    "agent_id",
    "version",
    "persona",
    "instructions",
    "model_profile_id"
  ],
  "title": "AgentVersion",
  "type": "object"
}
