{
  "$defs": {
    "ModelAccessMode": {
      "description": "Select who owns the provider credentials and model bill.",
      "enum": [
        "customer_managed",
        "weaves_managed"
      ],
      "title": "ModelAccessMode",
      "type": "string"
    },
    "ModelProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:/-]+$",
          "title": "Model",
          "type": "string"
        },
        "display_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "default_temperature": {
          "default": 0.2,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Default Temperature",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 2048,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "context_window_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Window Tokens"
        },
        "model_traits": {
          "items": {
            "$ref": "#/$defs/ModelTrait"
          },
          "maxItems": 4,
          "title": "Model Traits",
          "type": "array"
        },
        "model_description": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Description"
        },
        "cost_budget_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Budget Usd"
        },
        "input_cost_per_million_tokens_usd": {
          "anyOf": [
            {
              "maximum": 100000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Cost Per Million Tokens Usd"
        },
        "output_cost_per_million_tokens_usd": {
          "anyOf": [
            {
              "maximum": 100000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Cost Per Million Tokens Usd"
        },
        "fallback_model_profile_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Model Profile Id"
        },
        "status": {
          "$ref": "#/$defs/ModelProfileStatus"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "org_id",
        "id",
        "provider_id",
        "model",
        "display_name",
        "status"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "ModelProfileStatus": {
      "enum": [
        "active",
        "disabled"
      ],
      "title": "ModelProfileStatus",
      "type": "string"
    },
    "ModelProvider": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "org_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider_type": {
          "$ref": "#/$defs/ModelProviderType"
        },
        "display_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "allowed_models": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:/-]+$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Allowed Models",
          "type": "array"
        },
        "auth_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth Ref"
        },
        "credential_last4": {
          "anyOf": [
            {
              "maxLength": 4,
              "minLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Last4"
        },
        "base_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "status": {
          "$ref": "#/$defs/ModelProviderStatus"
        }
      },
      "required": [
        "org_id",
        "id",
        "provider_type",
        "display_name",
        "allowed_models",
        "status"
      ],
      "title": "ModelProvider",
      "type": "object"
    },
    "ModelProviderStatus": {
      "enum": [
        "active",
        "disabled"
      ],
      "title": "ModelProviderStatus",
      "type": "string"
    },
    "ModelProviderType": {
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "azure_openai",
        "bedrock",
        "openai_compatible",
        "local"
      ],
      "title": "ModelProviderType",
      "type": "string"
    },
    "ModelTrait": {
      "enum": [
        "Balanced",
        "Reasoning",
        "Fast"
      ],
      "title": "ModelTrait",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A resolved profile/provider pair with cross-reference scope checked.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "provider": {
      "$ref": "#/$defs/ModelProvider"
    },
    "profile": {
      "$ref": "#/$defs/ModelProfile"
    },
    "access_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelAccessMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "provider",
    "profile"
  ],
  "title": "ModelProfileBinding",
  "type": "object"
}
