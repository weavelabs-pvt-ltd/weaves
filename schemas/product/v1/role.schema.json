{
  "$defs": {
    "Permission": {
      "enum": [
        "organizations.admin",
        "workspaces.admin",
        "users.manage",
        "roles.manage",
        "models.manage",
        "models.view",
        "agents.manage",
        "agents.run",
        "agents.view",
        "workflows.manage",
        "workflows.run",
        "workflows.view",
        "plugins.manage",
        "plugins.view",
        "knowledge.view",
        "artifacts.read",
        "actions.approve",
        "approval_policies.manage",
        "audit.read"
      ],
      "title": "Permission",
      "type": "string"
    },
    "SystemRoleKey": {
      "enum": [
        "admin",
        "builder",
        "user"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "permissions": {
      "items": {
        "$ref": "#/$defs/Permission"
      },
      "title": "Permissions",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "system_role_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/SystemRoleKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "org_id",
    "name"
  ],
  "title": "Role",
  "type": "object"
}
