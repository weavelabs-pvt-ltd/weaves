{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Source reference used to build an execution artifact.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_type": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Type",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_ref",
        "recorded_at"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "ArtifactSensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "ArtifactSensitivity",
      "type": "string"
    },
    "ArtifactStatus": {
      "enum": [
        "available",
        "deleted"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "RetentionClass": {
      "enum": [
        "ephemeral",
        "standard",
        "regulated",
        "locked"
      ],
      "title": "RetentionClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Durable output and bounded provenance from an execution.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "agent_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Run Id"
    },
    "artifact_type": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Artifact Type",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "default": "",
      "maxLength": 120000,
      "title": "Summary",
      "type": "string"
    },
    "content_ref": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Content Ref",
      "type": "string"
    },
    "content_type": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Content Type",
      "type": "string"
    },
    "checksum": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checksum"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ArtifactProvenance"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "sensitivity": {
      "$ref": "#/$defs/ArtifactSensitivity"
    },
    "retention_class": {
      "$ref": "#/$defs/RetentionClass"
    },
    "status": {
      "$ref": "#/$defs/ArtifactStatus"
    },
    "created_by_agent_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By Agent Run Id"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "org_id",
    "workspace_id",
    "artifact_id",
    "run_id",
    "artifact_type",
    "title",
    "content_ref",
    "content_type",
    "provenance",
    "sensitivity",
    "retention_class",
    "status"
  ],
  "title": "Artifact",
  "type": "object"
}
