{
  "$defs": {
    "ErrorSummary": {
      "additionalProperties": false,
      "description": "Bounded user-safe error details; stack traces and provider payloads do not belong here.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "code": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "summary"
      ],
      "title": "ErrorSummary",
      "type": "object"
    },
    "ExecutionJobStatus": {
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ExecutionJobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Durable request envelope for work processed by a separate worker.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "org_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Org Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "requested_by_principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Requested By Principal Id",
      "type": "string"
    },
    "task": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Task",
      "type": "string"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
