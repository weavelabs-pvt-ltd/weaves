{
  "$defs": {
    "CapabilityKind": {
      "enum": [
        "context.read",
        "action.write",
        "delivery.send"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "CapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Capability Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "risk_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "approval_supported": {
          "default": false,
          "title": "Approval Supported",
          "type": "boolean"
        }
      },
      "required": [
        "capability_id",
        "name",
        "kind",
        "input_schema",
        "output_schema"
      ],
      "title": "CapabilitySpec",
      "type": "object"
    },
    "JsonValue": {},
    "PluginDescriptorStatus": {
      "enum": [
        "active",
        "deprecated",
        "disabled"
      ],
      "title": "PluginDescriptorStatus",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "plugin_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Plugin Id",
      "type": "string"
    },
    "plugin_type": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Plugin Type",
      "type": "string"
    },
    "display_name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "capability_manifest": {
      "items": {
        "$ref": "#/$defs/CapabilitySpec"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Capability Manifest",
      "type": "array"
    },
    "auth_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auth Schema"
    },
    "configuration_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Schema"
    },
    "status": {
      "$ref": "#/$defs/PluginDescriptorStatus"
    }
  },
  "required": [
    "plugin_id",
    "plugin_type",
    "display_name",
    "capability_manifest",
    "status"
  ],
  "title": "PluginDescriptor",
  "type": "object"
}
